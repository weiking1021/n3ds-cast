# Uploads a finished build to a console over FTP. Independent of the build (see Dockerfile.build). Run it with ./deploy.sh (deploy.bat on Windows).
FROM python@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
COPY 3ds/deploy/deploy.py /deploy.py
ENV N3DS_FTP_HOST=3ds-ftpd.local N3DS_FTP_PORT=5000
ENTRYPOINT ["python", "/deploy.py", "/build"]
